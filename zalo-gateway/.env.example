# Account B session — never commit real values.
ZALO_COOKIE_JSON=[]
ZALO_IMEI=
ZALO_USER_AGENT=
ZALO_BOT_ACCOUNT_ID=

# Only account A is allowed to control B.
ZALO_CONTROLLER_ID=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZALO_BRIDGE_SECRET=

# Optional same-container base URL.
# Default: http://127.0.0.1:$PORT/internal/zalo
ZALO_BRIDGE_BASE_URL=
ZALO_GROUP_REFRESH_MS=60000
ZALO_GROUP_RETENTION_DAYS=30
