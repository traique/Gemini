# Gemini Telegram Bot - mau bien moi truong.
# Copy thanh .env roi dien gia tri that:  cp .env.example .env
# KHONG commit file .env. Danh sach nay khop voi core/config.py.

# ===== BAT BUOC - thieu la bot khong khoi dong =====

# Token tu @BotFather
TELEGRAM_TOKEN=

# Telegram user ID duy nhat duoc phep dung bot (lay tu @userinfobot).
ALLOWED_USER_ID=

# Cookie dang nhap gemini.google.com (F12 > Network > Cookies).
# CANH BAO: __Secure-1PSID la session token TOAN QUYEN tai khoan Google.
GEMINI_SECURE_1PSID=
GEMINI_SECURE_1PSIDTS=

# Connection string Supabase - PHAI dung tab "Session pooler".
# Khong dung "Direct connection" (IPv6-only, se loi Network is unreachable).
DATABASE_URL=

# ===== CHI BAT BUOC KHI CHAY web.py (webhook / Render) =====
# Chay main.py (long polling) thi bo trong ca hai.

# Tao bang: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Vd https://ten-service.onrender.com
# Tren Render co the bo trong - bot tu doc RENDER_EXTERNAL_URL.
WEBHOOK_BASE_URL=

# ===== KHUYEN NGHI MANH - bo trong van chay nhung mat tinh nang =====

# Lop du phong khi cookie loi: https://aistudio.google.com/apikey
# Bo trong ca hai = cookie chet la bot ngom.
# Tri nho dai han va function calling CAN key nay moi hoat dong.
GOOGLE_AI_STUDIO_API_KEY_1=
GOOGLE_AI_STUDIO_API_KEY_2=

# Khoa Fernet ma hoa du lieu nhay cam truoc khi luu DB (cookie da rotate).
# Bo trong = cookie luu DANG PLAINTEXT trong bang settings.
# Tao bang:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENC_KEY=

# Secret cho endpoint /diagnose, truyen qua header X-Diagnose-Token.
# Bo trong = /diagnose LUON tra 403 (fail-closed).
DIAGNOSE_SECRET=

# ===== TUY CHON - deu co gia tri mac dinh hop ly =====

# Proxy HTTP(S) cho nhanh cookie, neu can.
GEMINI_PROXY=

# Model dung cho nhanh API.
GOOGLE_AI_STUDIO_MODEL=gemini-2.5-flash

# Thu tu uu tien provider. Dat api1,api2,cookie de uu tien API chinh thuc
# (on dinh hon, doi lai co quota gioi han).
PROVIDER_ORDER=cookie,api1,api2

# Duong dan file persona (.yaml co cau truc, hoac .txt tho de tuong thich nguoc).
CHAT_SKILL_PATH=chat_skill.yaml

# --- Provider-chain / cookie ---
# Chu ky tu thu lai cookie khi dang o nhanh API (giay).
COOKIE_PROBE_INTERVAL_SEC=900
# Cooldown khi 1 API key het quota (giay).
API_QUOTA_COOLDOWN_SEC=3600
# Chu ky gemini-webapi refresh __Secure-1PSIDTS (giay).
GEMINI_COOKIE_REFRESH_INTERVAL=540
# Timeout toi da cho 1 loi goi qua nhanh cookie (giay).
GEMINI_COOKIE_CALL_TIMEOUT_SEC=18
# Bat log chi tiet cua gemini-webapi. CHI dung khi debug.
GEMINI_WEBAPI_DEBUG=false

# --- Tri nho hoi thoai ---
# So luot chat gan nhat nap lai cho nhanh API.
CHAT_HISTORY_TURNS=8
# Nghi qua thoi gian nay thi coi phien da ket thuc (giay, mac dinh 6 gio).
CHAT_SESSION_TIMEOUT_SEC=21600

# --- Scheduler ---
# Chu ky quet reminder den han (giay).
REMINDER_CHECK_INTERVAL_SEC=30
# Bat/tat digest danh muc hang ngay.
ENABLE_DAILY_DIGEST=true
# Gio gui digest (gio VN).
DAILY_DIGEST_HOUR_VN=8

# --- Telegram API / file ---
# Thu muc luu file tam.
MEDIA_DIR=media
# Timeout goi Telegram Bot API (giay). Tang neu hay gap TimedOut khi tai anh.
TELEGRAM_CONNECT_TIMEOUT=30
TELEGRAM_READ_TIMEOUT=90
TELEGRAM_WRITE_TIMEOUT=90
TELEGRAM_POOL_TIMEOUT=30
# So lan thu lai khi tai anh/file that bai.
TELEGRAM_MEDIA_RETRIES=3
